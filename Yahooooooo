import truststore
truststore.inject_into_ssl()

import requests
import time

from datetime import datetime, timezone


# ==================================================
# CONFIGURATION
# ==================================================

STOCKS = {
    "Reliance Industries": "RELIANCE.NS",
    "Tata Consultancy Services": "TCS.NS",
    "Infosys": "INFY.NS",
    "HDFC Bank": "HDFCBANK.NS",
    "ICICI Bank": "ICICIBANK.NS",
    "Tata Steel": "TATASTEEL.NS",
    "State Bank of India": "SBIN.NS",
    "ITC": "ITC.NS",
    "Sun Pharmaceutical": "SUNPHARMA.NS",
    "Bharti Airtel": "BHARTIARTL.NS",
    "Adani Enterprises": "ADANIENT.NS",
    "Coal India": "COALINDIA.NS",
    "Bajaj Finance": "BAJFINANCE.NS",

    # US STOCK
    "MARA Holdings Inc.": "MARA"
}

YAHOO_URL = (
    "https://query1.finance.yahoo.com/"
    "v8/finance/chart/"
)

POLL_INTERVAL = 30
REQUEST_TIMEOUT = 20
REQUEST_GAP = 1


# ==================================================
# YAHOO FINANCE SESSION
# ==================================================

session = requests.Session()

session.headers.update({
    "User-Agent": "Mozilla/5.0"
})


# ==================================================
# FETCH STOCK PRICE
# ==================================================

def fetch_yahoo_price(name, symbol):

    url = f"{YAHOO_URL}{symbol}"

    response = session.get(
        url,
        params={
            "range": "1d",
            "interval": "1m"
        },
        timeout=REQUEST_TIMEOUT
    )

    response.raise_for_status()

    chart = response.json().get("chart", {})

    if chart.get("error"):
        raise ValueError(chart["error"])

    results = chart.get("result")

    if not results:
        raise ValueError("No chart data returned")

    data = results[0]

    meta = data.get("meta", {})

    quote_list = (
        data.get("indicators", {})
        .get("quote", [])
    )

    if not quote_list:
        raise ValueError("No quote data available")

    quote = quote_list[0]

    timestamps = data.get("timestamp", [])
    closes = quote.get("close", [])
    volumes = quote.get("volume", [])

    valid_rows = []

    for timestamp, close, volume in zip(
        timestamps,
        closes,
        volumes
    ):

        if close is not None:

            valid_rows.append(
                (timestamp, close, volume)
            )

    if not valid_rows:
        raise ValueError("No valid price available")

    timestamp, candle_price, volume = valid_rows[-1]

    # ==============================================
    # CURRENT PRICE
    # ==============================================

    current_price = meta.get("regularMarketPrice")

    if current_price is None:
        current_price = candle_price

    current_price = float(current_price)

    # ==============================================
    # PREVIOUS CLOSE AND CHANGE
    # ==============================================

    previous_close = meta.get("previousClose")

    if previous_close is not None and float(previous_close) > 0:

        previous_close = float(previous_close)

        change = current_price - previous_close

        change_percent = (
            change / previous_close
        ) * 100

    else:

        change = None
        change_percent = None

    # ==============================================
    # TIMESTAMP
    # ==============================================

    source_time = datetime.fromtimestamp(
        timestamp,
        timezone.utc
    ).isoformat()

    # ==============================================
    # RETURN RESULT
    # ==============================================

    return {
        "name": meta.get("longName", name),
        "ticker": symbol,
        "price": round(current_price, 2),
        "previous_close": previous_close,
        "change": (
            round(change, 2)
            if change is not None else None
        ),
        "change_percent": (
            round(change_percent, 2)
            if change_percent is not None else None
        ),
        "currency": meta.get("currency", "UNKNOWN"),
        "volume": volume,
        "source_timestamp": source_time,
        "source": "Yahoo Finance"
    }


# ==================================================
# FETCH ALL STOCKS
# ==================================================

def fetch_all_stocks():

    successful = 0
    failed = 0

    print("\n" + "=" * 100)

    print("YAHOO FINANCE - STOCK PRICE MONITOR")

    print(
        "Fetch time:",
        datetime.now().astimezone()
    )

    print("=" * 100)

    for name, symbol in STOCKS.items():

        try:

            result = fetch_yahoo_price(
                name,
                symbol
            )

            price = result["price"]
            change = result["change"]
            percent = result["change_percent"]
            currency = result["currency"]

            if change is not None and percent is not None:

                sign = "+" if change >= 0 else ""

                print(
                    f"\n[SUCCESS] "
                    f"{result['name']} ({symbol})"
                )

                print(
                    f"Price  : {currency} {price:.2f}"
                )

                print(
                    f"Change : {sign}{change:.2f} "
                    f"({sign}{percent:.2f}%)"
                )

            else:

                print(
                    f"\n[SUCCESS] "
                    f"{result['name']} ({symbol})"
                )

                print(
                    f"Price  : {currency} {price:.2f}"
                )

                print(
                    "Change : Unavailable"
                )

            print(
                f"Volume : {result['volume']}"
            )

            print(
                f"Source timestamp : "
                f"{result['source_timestamp']}"
            )

            successful += 1

        except Exception as error:

            print(
                f"\n[FAILED] {name} ({symbol})"
            )

            print("Error:", error)

            failed += 1

        time.sleep(REQUEST_GAP)

    # ==============================================
    # SUMMARY
    # ==============================================

    print("\n" + "-" * 100)

    print("FETCH SUMMARY")

    print("Total stocks :", len(STOCKS))
    print("Successful   :", successful)
    print("Failed       :", failed)

    print("-" * 100)


# ==================================================
# CONTINUOUS EXECUTION
# ==================================================

if __name__ == "__main__":

    print("=" * 100)

    print("CONTINUOUS YAHOO FINANCE STOCK MONITOR")

    print("=" * 100)

    print("Total stocks     :", len(STOCKS))
    print("Indian stocks    :", len(STOCKS) - 1)
    print("US stocks        :", 1)
    print("Polling interval :", POLL_INTERVAL, "seconds")
    print("Chart interval   : 1 minute")
    print("Data source      : Yahoo Finance")

    print("\nPress CTRL + C to stop.")

    try:

        while True:

            cycle_start = time.monotonic()

            fetch_all_stocks()

            elapsed = time.monotonic() - cycle_start

            remaining = max(
                0,
                POLL_INTERVAL - elapsed
            )

            print(
                f"\nNext fetch in "
                f"{remaining:.1f} seconds..."
            )

            time.sleep(remaining)

    except KeyboardInterrupt:

        print("\n\nStopping Yahoo Finance monitor...")

    finally:

        session.close()

        print("Yahoo Finance session closed.")
        print("Monitor stopped.")
