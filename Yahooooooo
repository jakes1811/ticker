
import truststore
truststore.inject_into_ssl()

import time
import requests
from datetime import datetime
from zoneinfo import ZoneInfo

# ---------------- CONFIGURATION ----------------

STOCKS = {
    "Reliance Industries": "RELIANCE.NS",
    "Tata Consultancy Services": "TCS.NS",
    "Infosys": "INFY.NS",
    "HDFC Bank": "HDFCBANK.NS",
    "ICICI Bank": "ICICIBANK.NS",
    "Tata Steel": "TATASTEEL.NS",
    "State Bank of India": "SBIN.NS",
    "ITC": "ITC.NS",
    "Sun Pharmaceutical": "SUNPHARMA.NS",
    "Bharti Airtel": "BHARTIARTL.NS",
    "Adani Enterprises": "ADANIENT.NS",
    "Coal India": "COALINDIA.NS",
    "Bajaj Finance": "BAJFINANCE.NS",

    # US stock for testing
    "MARA Holdings, Inc.": "MARA"
}

YAHOO_URL = "https://query1.finance.yahoo.com/v8/finance/chart/"

POLL_INTERVAL = 30
REQUEST_TIMEOUT = 20
REQUEST_GAP = 1

session = requests.Session()
session.headers.update({
    "User-Agent": "Mozilla/5.0"
})

# ---------------- FETCH STOCK DATA ----------------

def fetch_yahoo_price(name, symbol):

    try:
        url = f"{YAHOO_URL}{symbol}"

        params = {
            "range": "1d",
            "interval": "1m"
        }

        response = session.get(
            url,
            params=params,
            timeout=REQUEST_TIMEOUT
        )

        response.raise_for_status()

        data = response.json()

        result = data["chart"]["result"]

        if not result:
            raise ValueError("No stock data returned")

        stock_data = result[0]
        meta = stock_data["meta"]

        price = meta.get("regularMarketPrice")
        previous_close = meta.get("previousClose")

        if price is None:
            raise ValueError("Current price unavailable")

        price = float(price)

        if previous_close is None:
            raise ValueError("Previous closing price unavailable")

        previous_close = float(previous_close)

        if previous_close == 0:
            raise ValueError("Previous close is zero")

        change = price - previous_close
        change_percent = (change / previous_close) * 100

        currency = meta.get("currency", "UNKNOWN")

        market_timestamp = meta.get("regularMarketTime")

        if market_timestamp:
            source_time = datetime.fromtimestamp(
                market_timestamp,
                tz=ZoneInfo("UTC")
            ).isoformat()
        else:
            source_time = datetime.now(
                ZoneInfo("UTC")
            ).isoformat()

        return {
            "name": name,
            "symbol": symbol,
            "price": price,
            "change": change,
            "change_percent": change_percent,
            "currency": currency,
            "source_timestamp": source_time,
            "source": "Yahoo Finance"
        }

    except Exception as e:
        print(f"[ERROR] {name} ({symbol}): {e}")
        return None


# ---------------- DISPLAY STOCK DATA ----------------

def display_stock(stock):

    currency_symbol = "₹" if stock["currency"] == "INR" else "$"

    price = stock["price"]
    change = stock["change"]
    percentage = stock["change_percent"]

    sign = "+" if change >= 0 else ""

    print(f"\n{stock['name']} ({stock['symbol']})")
    print("-" * 50)

    print(f"Price  : {currency_symbol}{price:,.2f}")

    print(
        f"Change : {sign}{currency_symbol}{change:,.2f} "
        f"({sign if percentage >= 0 else ''}{percentage:.2f}%)"
    )

    print(f"Time   : {stock['source_timestamp']}")


# ---------------- FETCH ALL STOCKS ----------------

def fetch_all_stocks():

    print("\n" + "=" * 60)
    print("       YAHOO FINANCE - STOCK PRICE MONITOR")
    print("=" * 60)

    success_count = 0
    failure_count = 0

    for name, symbol in STOCKS.items():

        stock = fetch_yahoo_price(name, symbol)

        if stock:
            display_stock(stock)
            success_count += 1
        else:
            failure_count += 1

        time.sleep(REQUEST_GAP)

    print("\n" + "=" * 60)
    print(f"Successful : {success_count}")
    print(f"Failed     : {failure_count}")
    print("=" * 60)


# ---------------- CONTINUOUS EXECUTION ----------------

if __name__ == "__main__":

    print("Starting Yahoo Finance stock monitoring...")
    print(f"Stocks          : {len(STOCKS)}")
    print(f"Polling interval: {POLL_INTERVAL} seconds")
    print("Press CTRL + C to stop.")

    try:

        while True:

            cycle_start = time.time()

            print("\n\nFetching stock prices...")
            print("Fetch time:", datetime.now().strftime("%Y-%m-%d %H:%M:%S"))

            fetch_all_stocks()

            elapsed = time.time() - cycle_start
            remaining = max(0, POLL_INTERVAL - elapsed)

            print(f"\nNext update in {remaining:.1f} seconds...")

            time.sleep(remaining)

    except KeyboardInterrupt:
        print("\nStock monitoring stopped.")
