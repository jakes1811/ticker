
import truststore
truststore.inject_into_ssl()

import requests
import time
from datetime import datetime

# Configuration
COMPANY_ID = "11984"
POLL_INTERVAL = 30

URL = "https://marketservices.indiatimes.com/marketservices/company"

PARAMS = {
    "companyid": COMPANY_ID,
    "companytype": "equity"
}

HEADERS = {
    "User-Agent": "Mozilla/5.0",
    "Accept": "application/json"
}


def fetch_sbi_price(session):

    response = session.get(
        URL,
        params=PARAMS,
        headers=HEADERS,
        timeout=15
    )

    response.raise_for_status()

    data = response.json()
    nse = data.get("nse")

    if not nse:
        raise ValueError("NSE data not available")

    name = data.get("companyName", "State Bank of India")
    price = nse.get("current")
    change_percent = nse.get("percentChange")

    if price is None or change_percent is None:
        raise ValueError("Price or percentage change missing")

    return {
        "name": name,
        "price": float(price),
        "change_percent": float(change_percent)
    }


def main():

    print("=" * 55)
    print("       ECONOMIC TIMES - LIVE PRICE FETCHER")
    print("=" * 55)
    print("Stock       : State Bank of India")
    print("Interval    : 30 seconds")
    print("Source      : Economic Times")
    print("Press Ctrl+C to stop")
    print("=" * 55)

    with requests.Session() as session:

        while True:

            try:
                result = fetch_sbi_price(session)

                print(
                    f"\n[{datetime.now().strftime('%H:%M:%S')}] "
                    f"{result['name']} | "
                    f"Price: ₹{result['price']:.2f} | "
                    f"Change: {result['change_percent']:+.2f}%"
                )

            except requests.RequestException as error:
                print(f"\n[REQUEST ERROR] {error}")

            except (ValueError, KeyError, TypeError) as error:
                print(f"\n[DATA ERROR] {error}")

            except Exception as error:
                print(f"\n[ERROR] {error}")

            print(f"Next fetch in {POLL_INTERVAL} seconds...")
            time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\nFetcher stopped.")
