
import requests
import truststore

truststore.inject_into_ssl()

ET_COMPANY_URL = (
    "https://marketservices.indiatimes.com/marketservices/company"
)

ET_COMPANY_IDS = {
    "Reliance Industries": "13215",
    "Tata Consultancy Services": "8345",
    "Infosys": "10960",
    "HDFC Bank": "9195",
    "ICICI Bank": "9194",
    "Tata Steel": "12902",
    "State Bank of India": "11984",
    "ITC": "13554",
    "Sun Pharmaceutical": "9134",
    "Bharti Airtel": "2718"
}

session = requests.Session()
session.headers.update({
    "User-Agent": "Mozilla/5.0",
    "Accept": "application/json"
})

for expected_name, company_id in ET_COMPANY_IDS.items():

    try:
        response = session.get(
            ET_COMPANY_URL,
            params={
                "companyid": company_id,
                "companytype": "equity"
            },
            timeout=15
        )
        response.raise_for_status()

        data = response.json()
        nse = data.get("nse") or {}

        actual_name = data.get("companyName", "Unknown")
        price = nse.get("current")

        if (
            expected_name.lower() in actual_name.lower()
            and price is not None
        ):
            print(
                f"[VALID] {expected_name} | "
                f"₹{float(price):.2f}"
            )
        else:
            print(
                f"[VERIFY] Expected: {expected_name} | "
                f"Received: {actual_name} | "
                f"Price: {price}"
            )

    except Exception as error:
        print(f"[FAILED] {expected_name}: {error}")

session.close()
