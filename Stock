
import os
import json
import time
import warnings
from datetime import datetime, timezone

import requests
import truststore
from kafka import KafkaProducer


# ============================================================
# CONFIGURATION
# ============================================================

truststore.inject_into_ssl()
warnings.filterwarnings("ignore")

API_KEY = os.getenv("INDIANAPI_KEY", "").strip()

INDIANAPI_URL = "https://stock.indianapi.in/stock"

YAHOO_URL = (
    "https://query1.finance.yahoo.com/v8/finance/chart/"
)

ET_COMPANY_URL = (
    "https://marketservices.indiatimes.com/marketservices/company"
)


# ============================================================
# STOCKS
# ============================================================

STOCKS = {
    "Reliance Industries": "RELIANCE.NS",
    "Tata Consultancy Services": "TCS.NS",
    "Infosys": "INFY.NS",
    "HDFC Bank": "HDFCBANK.NS",
    "ICICI Bank": "ICICIBANK.NS",
    "Tata Steel": "TATASTEEL.NS",
    "State Bank of India": "SBIN.NS",
    "ITC": "ITC.NS",
    "Sun Pharmaceutical": "SUNPHARMA.NS",
    "Bharti Airtel": "BHARTIARTL.NS"
}


# ============================================================
# ECONOMIC TIMES COMPANY IDS
# ============================================================

ET_COMPANY_IDS = {
    "Reliance Industries": "13215",
    "Tata Consultancy Services": "8345",
    "Infosys": "10960",
    "HDFC Bank": "9195",
    "ICICI Bank": "9194",
    "Tata Steel": "12902",
    "State Bank of India": "11984",
    "ITC": "13554",
    "Sun Pharmaceutical": "9134",
    "Bharti Airtel": "2718"
}


# ============================================================
# KAFKA CONFIGURATION
# ============================================================

KAFKA_BROKER = "localhost:9092"
KAFKA_TOPIC = "stock-prices"


# ============================================================
# POLLING CONFIGURATION
# ============================================================

POLL_INTERVAL = 10
REQUEST_TIMEOUT = 15
REQUEST_GAP = 0.2


# ============================================================
# KAFKA PRODUCER
# ============================================================

producer = KafkaProducer(
    bootstrap_servers=KAFKA_BROKER,
    value_serializer=lambda value: json.dumps(value).encode("utf-8")
)


# ============================================================
# HTTP SESSIONS
# ============================================================

# IndianAPI session

api_session = requests.Session()

api_session.headers.update({
    "x-api-key": API_KEY
})


# Yahoo Finance session

yahoo_session = requests.Session()

yahoo_session.headers.update({
    "User-Agent": "Mozilla/5.0"
})


# Economic Times session

et_session = requests.Session()

et_session.headers.update({
    "User-Agent": "Mozilla/5.0",
    "Accept": "application/json"
})


# ============================================================
# TRACKING
# ============================================================

last_prices = {}
last_sources = {}


def get_timestamp():

    return datetime.now(timezone.utc).isoformat()


# ============================================================
# INDIANAPI - PRIMARY SOURCE
# ============================================================

def fetch_indianapi(stock_name):

    if not API_KEY:
        raise RuntimeError("INDIANAPI_KEY is missing")

    response = api_session.get(
        INDIANAPI_URL,
        params={"name": stock_name},
        timeout=REQUEST_TIMEOUT
    )

    response.raise_for_status()

    data = response.json()

    company_name = data.get("companyName", stock_name)

    current_price = (
        data.get("currentPrice", {}).get("NSE")
    )

    if current_price is None:
        raise ValueError("NSE price unavailable")

    current_price = float(current_price)

    percent_change = data.get("percentChange")

    change = None

    if percent_change is not None:

        percent_change = float(percent_change)

        if percent_change > -100:

            previous_close = (
                current_price / (1 + percent_change / 100)
            )

            change = current_price - previous_close

    return {
        "name": company_name,
        "symbol": STOCKS[stock_name],
        "current_price": current_price,
        "change": change,
        "change_percent": percent_change,
        "currency": "INR",
        "source": "IndianAPI",
        "timestamp": get_timestamp()
    }


# ============================================================
# YAHOO FINANCE DIRECT JSON - FALLBACK 1
# ============================================================

def fetch_yahoo(stock_name):

    symbol = STOCKS[stock_name]

    response = yahoo_session.get(
        f"{YAHOO_URL}{symbol}",
        params={
            "range": "1d",
            "interval": "1m"
        },
        timeout=REQUEST_TIMEOUT
    )

    response.raise_for_status()

    data = response.json()

    results = data.get("chart", {}).get("result")

    if not results:

        error = data.get("chart", {}).get("error")

        raise ValueError(
            f"Yahoo data unavailable: {error}"
        )

    stock_data = results[0]

    meta = stock_data.get("meta", {})

    current_price = meta.get("regularMarketPrice")

    previous_close = meta.get("previousClose")

    if previous_close is None:

        previous_close = meta.get("chartPreviousClose")

    if current_price is None:
        raise ValueError("Yahoo current price unavailable")

    if previous_close is None:
        raise ValueError("Yahoo previous close unavailable")

    current_price = float(current_price)

    previous_close = float(previous_close)

    if previous_close == 0:
        raise ValueError("Previous closing price is zero")

    change = current_price - previous_close

    change_percent = (
        change / previous_close
    ) * 100

    market_timestamp = meta.get("regularMarketTime")

    if market_timestamp:

        source_timestamp = datetime.fromtimestamp(
            market_timestamp,
            tz=timezone.utc
        ).isoformat()

    else:

        source_timestamp = get_timestamp()

    return {
        "name": stock_name,
        "symbol": symbol,
        "current_price": current_price,
        "change": change,
        "change_percent": change_percent,
        "currency": meta.get("currency", "INR"),
        "source": "Yahoo Finance",
        "timestamp": source_timestamp,
        "fetched_at": get_timestamp()
    }


# ============================================================
# ECONOMIC TIMES JSON - FALLBACK 2
# ============================================================

def fetch_economic_times(stock_name):

    company_id = ET_COMPANY_IDS.get(stock_name)

    if not company_id:
        raise ValueError(
            f"Economic Times company ID missing for {stock_name}"
        )

    response = et_session.get(
        ET_COMPANY_URL,
        params={
            "companyid": company_id,
            "companytype": "equity"
        },
        timeout=REQUEST_TIMEOUT
    )

    response.raise_for_status()

    data = response.json()

    nse = data.get("nse")

    if not isinstance(nse, dict):
        raise ValueError("Economic Times NSE data unavailable")

    current_price = nse.get("current")

    change = nse.get("absoluteChange")

    change_percent = nse.get("percentChange")

    if current_price is None:
        raise ValueError("Economic Times current price missing")

    if change_percent is None:
        raise ValueError("Economic Times percentage change missing")

    return {
        "name": data.get("companyName", stock_name),
        "symbol": STOCKS[stock_name],
        "current_price": float(current_price),
        "change": (
            float(change) if change is not None else None
        ),
        "change_percent": float(change_percent),
        "currency": "INR",
        "source": "Economic Times",
        "timestamp": (
            nse.get("updatedDateTime") or get_timestamp()
        )
    }


# ============================================================
# KAFKA PUBLISHING
# ============================================================

def publish_to_kafka(message):

    name = message["name"]

    symbol = message["symbol"]

    price = message["current_price"]

    source = message["source"]

    previous_price = last_prices.get(symbol)

    previous_source = last_sources.get(symbol)

    # Publish only if price or source changes.

    if (
        previous_price != price
        or previous_source != source
    ):

        future = producer.send(
            KAFKA_TOPIC,
            value=message
        )

        future.get(timeout=10)

        last_prices[symbol] = price

        last_sources[symbol] = source

    # Display only name, price and percentage change.

    currency = message.get("currency", "INR")

    currency_symbol = "₹" if currency == "INR" else "$"

    percent = message.get("change_percent")

    if percent is not None:
        change_text = f"{percent:+.2f}%"
    else:
        change_text = "Unavailable"

    print(
        f"{name} | "
        f"Price: {currency_symbol}{price:.2f} | "
        f"Change: {change_text}"
    )


# ============================================================
# STOCK PROCESSING
# ============================================================

def process_stock(stock_name):

    # --------------------------------------------------------
    # STEP 1: INDIANAPI
    # --------------------------------------------------------

    try:

        message = fetch_indianapi(stock_name)

        publish_to_kafka(message)

        return

    except Exception as error:

        print(
            f"[INDIANAPI FAILED] {stock_name}: {error}"
        )

    # --------------------------------------------------------
    # STEP 2: YAHOO FINANCE
    # --------------------------------------------------------

    try:

        message = fetch_yahoo(stock_name)

        publish_to_kafka(message)

        return

    except Exception as error:

        print(
            f"[YAHOO FAILED] {stock_name}: {error}"
        )

    # --------------------------------------------------------
    # STEP 3: ECONOMIC TIMES
    # --------------------------------------------------------

    try:

        message = fetch_economic_times(stock_name)

        publish_to_kafka(message)

        return

    except Exception as error:

        print(
            f"[ET FAILED] {stock_name}: {error}"
        )

    print(
        f"[ALL SOURCES FAILED] {stock_name}"
    )


# ============================================================
# FETCH AND PUBLISH ALL STOCKS
# ============================================================

def fetch_and_publish():

    for stock_name in STOCKS:

        process_stock(stock_name)

        time.sleep(REQUEST_GAP)

    producer.flush()


# ============================================================
# MAIN LOOP
# ============================================================

if __name__ == "__main__":

    print("=" * 60)

    print("       INDIAN STOCK PRICE KAFKA PRODUCER")

    print("=" * 60)

    print("Primary source : IndianAPI")

    print("Fallback 1     : Yahoo Finance Direct JSON")

    print("Fallback 2     : Economic Times JSON")

    print("Polling interval:", POLL_INTERVAL, "seconds")

    print("Total stocks   :", len(STOCKS))

    print("Kafka broker   :", KAFKA_BROKER)

    print("Kafka topic    :", KAFKA_TOPIC)

    if not API_KEY:

        print(
            "[WARNING] INDIANAPI_KEY missing. "
            "Yahoo fallback will be used."
        )

    print("\nPress Ctrl+C to stop.")

    try:

        while True:

            cycle_start = time.monotonic()

            print("\n" + "=" * 60)

            print("FETCHING STOCK PRICES")

            print("Fetch time:", get_timestamp())

            print("=" * 60)

            fetch_and_publish()

            elapsed = time.monotonic() - cycle_start

            remaining = max(
                0,
                POLL_INTERVAL - elapsed
            )

            print(
                f"\nNext update in {remaining:.1f} seconds..."
            )

            time.sleep(remaining)

    except KeyboardInterrupt:

        print("\nStopping producer...")

    finally:

        producer.flush()

        producer.close()

        api_session.close()

        yahoo_session.close()

        et_session.close()

        print("Producer stopped.")
