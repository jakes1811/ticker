
import truststore
truststore.inject_into_ssl()

import os
import time
import json
import requests
import yfinance as yf

from curl_cffi import requests as curl_requests
from datetime import datetime
from zoneinfo import ZoneInfo

from kafka import KafkaProducer
from kafka.errors import KafkaError


# ==========================================
# CONFIGURATION
# ==========================================

API_KEY = os.getenv("INDIANAPI_KEY", "").strip()

INDIAN_API_URL = "https://stock.indianapi.in/stock"

KAFKA_BROKER = "localhost:9092"
KAFKA_TOPIC = "stock-prices"

POLL_INTERVAL = 30

# IndianAPI company names mapped to Yahoo NSE symbols

STOCKS = {
    "Reliance Industries": "RELIANCE.NS",
    "Tata Consultancy Services": "TCS.NS",
    "Infosys": "INFY.NS",
    "HDFC Bank": "HDFCBANK.NS",
    "ICICI Bank": "ICICIBANK.NS",
    "Tata Steel": "TATASTEEL.NS",
    "State Bank of India": "SBIN.NS",
    "ITC": "ITC.NS",
    "Sun Pharmaceutical": "SUNPHARMA.NS",
    "Bharti Airtel": "BHARTIARTL.NS"
}

if not API_KEY:
    raise ValueError("INDIANAPI_KEY is missing")


# ==========================================
# KAFKA PRODUCER
# ==========================================

producer = KafkaProducer(
    bootstrap_servers=KAFKA_BROKER,
    value_serializer=lambda value: json.dumps(value).encode("utf-8")
)


# ==========================================
# HTTP SESSIONS
# ==========================================

indian_session = requests.Session()

indian_session.headers.update({
    "x-api-key": API_KEY
})

# Yahoo Finance session.
# Certificate verification remains enabled.
yahoo_session = curl_requests.Session(
    impersonate="chrome"
)


# ==========================================
# PRICE STATE
# ==========================================

last_prices = {}


# ==========================================
# PRIMARY: INDIANAPI
# ==========================================

def fetch_indianapi(stock_name):

    response = indian_session.get(
        INDIAN_API_URL,
        params={"name": stock_name},
        timeout=15
    )

    response.raise_for_status()

    data = response.json()

    company_name = data.get("companyName", stock_name)

    price = data.get("currentPrice", {}).get("NSE")

    if price is None:
        raise ValueError("NSE price missing from IndianAPI response")

    price = float(price)

    if price <= 0:
        raise ValueError("Invalid IndianAPI price")

    return {
        "name": company_name,
        "current_price": price,
        "source": "INDIANAPI"
    }


# ==========================================
# BACKUP: YFINANCE
# ==========================================

def fetch_yfinance(stock_name, yahoo_symbol):

    ticker = yf.Ticker(
        yahoo_symbol,
        session=yahoo_session
    )

    history = ticker.history(
        period="1d",
        interval="1m",
        auto_adjust=False
    )

    if history.empty or history["Close"].dropna().empty:
        raise ValueError("No intraday price available from YFinance")

    latest_timestamp = history["Close"].dropna().index[-1]

    # Avoid treating yesterday's closing price as a live price.
    india_today = datetime.now(
        ZoneInfo("Asia/Kolkata")
    ).date()

    if latest_timestamp.date() != india_today:
        raise ValueError("YFinance has no price update for today's session")

    price = float(history["Close"].dropna().iloc[-1])

    if price <= 0:
        raise ValueError("Invalid YFinance price")

    return {
        "name": stock_name,
        "current_price": price,
        "source": "YFINANCE"
    }


# ==========================================
# PRICE FETCH WITH AUTOMATIC FAILOVER
# ==========================================

def fetch_stock(stock_name, yahoo_symbol):

    try:
        result = fetch_indianapi(stock_name)

        print(f"[PRIMARY] {stock_name}: IndianAPI")

        return result

    except Exception as error:

        print(f"[INDIANAPI FAILED] {stock_name}: {error}")
        print(f"[BACKUP] Trying YFinance for {stock_name}")

    try:
        result = fetch_yfinance(
            stock_name,
            yahoo_symbol
        )

        print(f"[BACKUP SUCCESS] {stock_name}: YFinance")

        return result

    except Exception as error:

        print(f"[BACKUP FAILED] {stock_name}: {error}")

        return None


# ==========================================
# KAFKA PUBLISHING
# ==========================================

def fetch_and_publish():

    for stock_name, yahoo_symbol in STOCKS.items():

        try:
            message = fetch_stock(
                stock_name,
                yahoo_symbol
            )

            if message is None:
                continue

            name = message["name"]
            price = message["current_price"]

            if last_prices.get(name) != price:

                future = producer.send(
                    KAFKA_TOPIC,
                    value=message
                )

                future.get(timeout=10)

                last_prices[name] = price

                print("[KAFKA PUBLISHED]", message)

            else:
                print(
                    f"[NO CHANGE] {name}: {price} "
                    f"({message['source']})"
                )

        except KafkaError as error:
            print(f"[KAFKA ERROR] {stock_name}: {error}")

        except Exception as error:
            print(f"[ERROR] {stock_name}: {error}")

    producer.flush()


# ==========================================
# MAIN LOOP
# ==========================================

if __name__ == "__main__":

    print("=" * 50)
    print("INDIAN STOCK PRICE PRODUCER")
    print("=" * 50)

    print("Primary source: IndianAPI")
    print("Backup source: YFinance")
    print("Polling interval:", POLL_INTERVAL, "seconds")
    print("Total stocks:", len(STOCKS))
    print("Kafka topic:", KAFKA_TOPIC)

    try:

        while True:

            print("\nFetching stock prices...")

            fetch_and_publish()

            print("\nWaiting 30 seconds...")

            time.sleep(POLL_INTERVAL)

    except KeyboardInterrupt:

        print("\nStopping producer...")

    finally:

        producer.flush()
        producer.close()

        indian_session.close()
        yahoo_session.close()

        print("Producer stopped.")

