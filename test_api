
import truststore
truststore.inject_into_ssl()

import os
import requests

API_KEY = os.getenv("INDIANAPI_KEY", "").strip()

url = "https://stock.indianapi.in/stock"

headers = {
    "x-api-key": API_KEY
}

params = {
    "name": "Tata Steel"
}

response = requests.get(
    url,
    headers=headers,
    params=params,
    timeout=20
)

print("Status:", response.status_code)
print("Response:", response.text[:3000])
